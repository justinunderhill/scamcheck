# Copy this file to .env and fill in your real keys. Never commit .env.

# Google API key for the URL blocklist source.
# The app uses Google Web Risk (the current API); set GOOGLE_SAFE_BROWSING_KEY
# and it's reused for Web Risk automatically. Set WEB_RISK_KEY only if you use a
# separate key. Enable the "Web Risk API" on the key's Google Cloud project.
GOOGLE_SAFE_BROWSING_KEY=your-google-api-key-here
# WEB_RISK_KEY=optional-separate-web-risk-key

# VirusTotal API key
VIRUSTOTAL_KEY=your-virustotal-key-here

# Anthropic API key (powers the AI explanation + message analysis layer)
ANTHROPIC_API_KEY=your-anthropic-key-here

# Backend
PORT=8000

# Frontend (Vite) — where the frontend should reach the backend
VITE_API_BASE_URL=http://localhost:8000
