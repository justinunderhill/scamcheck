# Copy this file to .env and fill in your real keys. Never commit .env.

# Google API key for the URL blocklist source.
# The app uses Google Web Risk (the current API); set GOOGLE_SAFE_BROWSING_KEY
# and it's reused for Web Risk automatically. Set WEB_RISK_KEY only if you use a
# separate key. Enable the "Web Risk API" on the key's Google Cloud project.
GOOGLE_SAFE_BROWSING_KEY=your-google-api-key-here
# WEB_RISK_KEY=optional-separate-web-risk-key

# VirusTotal API key
VIRUSTOTAL_KEY=your-virustotal-key-here

# Anthropic API key (powers the AI explanation + message analysis layer).
# NOTE: the AI layer only activates when a durable rate-limit store is also
# configured (see below) — or when AI_ALLOW_WITHOUT_DURABLE_BUDGET=true for
# single-process local dev. This protects the AI bill on serverless.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Durable abuse-protection store (Upstash Redis REST). Required for the AI layer
# in serverless/production so the daily AI-call budget actually holds across
# invocations. On Vercel, add the Upstash integration and these are injected
# automatically (UPSTASH_* or the legacy KV_* names are both accepted).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Local dev only: run the AI layer without a durable store (single process).
# AI_ALLOW_WITHOUT_DURABLE_BUDGET=true

# Backend
PORT=8000

# Frontend (Vite) — where the frontend should reach the backend
VITE_API_BASE_URL=http://localhost:8000
